# ============================================================================
# Discord bot
# ============================================================================
DISCORD_TOKEN=your-bot-token
GUILD_ID=1505952295391858810
# Optional overrides used by the bot
# PD_ROLE_ID=1505952295408631973
# FFMPEG_PATH=

# ============================================================================
# ORBAT database — Supabase PostgreSQL (single source of truth)
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the pooled connstring (port 6543) for hosted/serverless-style deploys,
# or the direct connection (port 5432). Include sslmode=require.
# ============================================================================
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# ============================================================================
# Control-panel API (web/api) — Discord OAuth2
# Create these in the Discord Developer Portal -> your app -> OAuth2.
# Add OAUTH_REDIRECT_URI to the app's "Redirects" list as well.
# ============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://your-bot-service.onrender.com/api/auth/callback

# Long random string used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# SESSION_TTL_SECONDS=604800

# Cross-site cookies (Cloudflare Pages -> Render) require these defaults.
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_SECURE=1

# Where the browser is sent after login + the allowed CORS origin (your Pages site).
FRONTEND_ORIGIN=https://your-panel.pages.dev
# POST_LOGIN_REDIRECT=https://your-panel.pages.dev

# ============================================================================
# Access control — who may use the panel.
# Comma-separated Discord role IDs. A user needs at least one matching role.
# ============================================================================
PANEL_ADMIN_ROLE_IDS=
PANEL_STAFF_ROLE_IDS=
PANEL_VIEWER_ROLE_IDS=
# Bootstrap allowlist of Discord user IDs (always treated as admin).
PANEL_ALLOW_USER_IDS=
